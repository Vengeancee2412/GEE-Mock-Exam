const IMG={57:"data:image/png;base64,",89:"data:image/png;base64,"};
const Q=RAW.split("\n").map(l=>{const p=l.split("|");return{n:+p[0],q:p[1],o:p.slice(2,6),a:+p[6]-1}});
let i=0,ans=Array(Q.length).fill(null),order=Q.map(q=>[0,1,2,3]);
const app=document.getElementById("app");
function shuf(a){for(let k=a.length-1;k>0;k--){const j=Math.floor(Math.random()*(k+1));[a[k],a[j]]=[a[j],a[k]]}return a}
function startOrder(){order=Q.map(()=>shuf([0,1,2,3]))}
startOrder();
function score(){return ans.filter((x,k)=>x!==null&&x===Q[k].a).length}
function done(){return ans.filter(x=>x!==null).length}
function grid(){return '<div class="grid">'+Q.map((q,k)=>`<button class="dot ${ans[k]===null?'':(ans[k]===q.a?'ok':'no')} ${k===i?'cur':''}" onclick="go(${k})">${q.n}</button>`).join("")+'</div>'}
function go(k){i=k;render()}
function pick(o){if(ans[i]!==null)return;ans[i]=o;render()}
function render(){
  if(i>=Q.length){const s=score();app.innerHTML=`<div class="card"><h2>Finished</h2><p>You answered ${done()} of ${Q.length} questions and got <b>${s}</b> correct (${Math.round(100*s/Q.length)}%).</p><div class="nav"><button class="btn" onclick="go(Q.length-1)">Review</button><button class="btn p" onclick="restart()">Restart (shuffle choices)</button></div></div>`+grid();return}
  const q=Q[i],a=ans[i];
  const opts=order[i].map((o,k)=>{let c="";if(a!==null){if(o===q.a)c="ok";else if(o===a)c="no"}
    return `<button class="opt ${c}" ${a!==null?"disabled":""} onclick="pick(${o})">${"ABCD"[k]}. ${q.o[o].replace(/</g,"&lt;")}</button>`}).join("");
  const fb=a===null?"":(a===q.a?"✓ Correct!":"✗ Wrong. Correct answer: "+q.o[q.a]);
  app.innerHTML=`<div class="top"><span>Question ${q.n} (${i+1} of ${Q.length})</span><span>Score ${score()}/${done()}</span></div>
  <div class="bar"><i style="width:${100*(i+1)/Q.length}%"></i></div>
  <div class="card"><p class="q">${q.n}. ${q.q.replace(/</g,"&lt;")}</p>${IMG[q.n]?`<img src="${IMG[q.n]}" alt="Figure for question ${q.n}">`:""}${opts}<div class="fb" style="color:${a===q.a?'var(--okb)':'var(--nob)'}">${fb}</div>
  <div class="nav"><button class="btn" ${i===0?"disabled":""} onclick="go(i-1)">Previous</button><span class="sp"></span><button class="btn p" onclick="go(i+1)">${i===Q.length-1?"Finish":"Next"}</button></div></div>`+grid();
}
function restart(){ans=Array(Q.length).fill(null);startOrder();i=0;render();scrollTo(0,0)}
render();
